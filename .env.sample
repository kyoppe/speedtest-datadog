# Datadog Settings
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com
# DD_ENV=production  # Optional: Set environment tag for traces

# Metric Settings
METRIC_PREFIX=test.kyouhei

# Custom Tags (comma separated)
DD_TAGS=env:home,host:mac-mini,location:tokyo

# Speedtest Settings
SPEEDTEST_SERVER_ID=14623  # Default: 14623 (Bunkyo, IPA CyberLab). Leave empty or comment out for auto selection
SPEEDTEST_FREQUENCY=300     # Default: 300 seconds (5 minutes)

# Observability Features
ENABLE_LOGS=false       # true to output JSON logs to stdout (collected by Datadog Agent)
ENABLE_TRACES=false     # true to send Datadog APM traces (requires Datadog Agent on localhost:8126)
