# Required
DD_API_KEY=

# Optional - Datadog settings
DD_SITE=datadoghq.com
# DD_ENV=dev # Uncomment and set if needed

# Optional - Metric settings
METRIC_PREFIX=test.kyouhei

# Optional - Tags (comma separated)
DD_TAGS=datacenter:machida

# Optional - Frequency (seconds)
SPEEDTEST_FREQUENCY=300

# Optional - Observability features
ENABLE_LOGS=true
ENABLE_TRACES=true

# Optional - Country filter file. Read before every test, so edits apply
# without a container restart. Contents: a country code (JP) or name (Japan).
# Servers in that country are tried nearest-first. A failed server tries the
# next server in the same country and does not fall back to automatic selection.
# Blank or missing file uses SPEEDTEST_SERVER_ID below, then automatic selection.
# SPEEDTEST_COUNTRY_FILE=/config/speedtest-country

# Optional - Speedtest server ID (e.g., 14623 for Bunkyo, 7139 for Tsukuba)
# Used only when the country file is blank or missing.
# If that server is unavailable, automatic selection is used.
# SPEEDTEST_SERVER_ID=

# Optional - Host hostname (for Docker deployments)
# IMPORTANT: Set this to differentiate metrics between multiple servers
# To get your hostname, run: hostname
# Example: HOST_HOSTNAME=machida-imac
# Note: Container ID and container name are auto-detected, no need to set them
# HOST_HOSTNAME=
